# Android / Gradle
.gradle/
**/build/
local.properties
*.iml
.idea/
.kotlin/
!gradle/wrapper/gradle-wrapper.properties
gradle/wrapper/gradle-wrapper.jar

# Secrets and machine-local config
.env
.env.*
!config/config.example/.env.example
keystore.properties
*.jks
*.keystore

# Private runtime data, user receipts, and backups
/data/**
!/data/.gitkeep
/runtime/**
*.db
*.db-shm
*.db-wal
*.backup
*.zip

# Outputs and logs
logs/**
!/logs/.gitkeep
releases/apk/*.apk
releases/checksums/*.sha256
*.log

# Ignore empty scaffolding files; all real project sources are tracked.
**/package-placeholder.txt

# Signing and user-local state
secrets/
local-data/
.DS_Store

# Generated versioned release binaries (keep manifests/docs in source control)
/releases/v*/RoadLedger_v*_debug.apk
/releases/v*/RoadLedger_v*_Source_Code.zip
/releases/v*/Vehicle_Tracker_v*_debug.apk
/releases/v*/Vehicle_Tracker_v*_Source_Code.zip
/releases/**/*.apk
/releases/**/*.zip

# Local pre-fix catalog snapshot created by scripts/fix_vehicle_catalog.py
scripts/vehicle_catalog_v2.0.0_pre_fix.csv
